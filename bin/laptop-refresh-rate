#!/usr/bin/env python3
import json
import pathlib
import subprocess
import time

supplies = pathlib.Path('/sys/class/power_supply')
while True:
    try:
        power_sources = [p for p in supplies.iterdir() if (p / 'online').exists() and (p / 'type').read_text().strip() in ('Mains', 'USB', 'USB_C', 'USB_PD')]
        if power_sources:
            plugged_in = any((p / 'online').read_text().strip() == '1' for p in power_sources)
            target = 144063 if plugged_in else 60061
            result = subprocess.run(['niri', 'msg', '-j', 'outputs'], capture_output=True, text=True, check=True)
            panel = json.loads(result.stdout).get('eDP-1')
            if panel and panel['current_mode'] is not None:
                mode = panel['modes'][panel['current_mode']]
                if mode['width'] != 1920 or mode['height'] != 1080 or mode['refresh_rate'] != target:
                    subprocess.run(['niri', 'msg', 'output', 'eDP-1', 'mode', f'1920x1080@{target / 1000:.3f}'], check=True)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        print(f'Refresh rate update: {exc}', flush=True)
    time.sleep(5)
